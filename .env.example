# PlantCare AI - Environment Configuration

# Core Application Settings
PROJECT_NAME="PlantCare AI"
VERSION="1.0.0"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# Model & Computer Vision Inference Settings
MODEL_CONFIDENCE_THRESHOLD=0.70
MAX_IMAGE_SIZE_MB=10

# Geospatial Search Settings
DEFAULT_SEARCH_RADIUS_KM=25.0
MAX_SEARCH_RADIUS_KM=100.0

# Database Configuration (for external PostgreSQL + PostGIS & Redis deployment)
DATABASE_URL="postgresql://plantcare_user:secure_pass@localhost:5432/plantcare_db"
REDIS_URL="redis://localhost:6379/0"
